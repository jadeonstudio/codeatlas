[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"},"kind":{"enum":["source","runtime","test","measurement","inference","document"]},"summary":{"type":"string","minLength":1,"maxLength":20000},"locator":{"type":"string","minLength":1,"maxLength":20000},"at":{"type":"string","format":"date-time"}},"required":["id","kind","summary"],"additionalProperties":true},"view":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"},"label":{"type":"string","minLength":1,"maxLength":160},"mode":{"enum":["flow","system","data","process"]},"description":{"type":"string","minLength":1,"maxLength":20000},"nodeIds":{"type":"array","items":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"},"uniqueItems":true,"maxItems":150},"edgeIds":{"type":"array","items":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"},"uniqueItems":true},"positions":{"type":"object","additionalProperties":{"type":"object","properties":{"x":{"type":"number","exclusiveMinimum":-100000,"exclusiveMaximum":100000},"y":{"type":"number","exclusiveMinimum":-100000,"exclusiveMaximum":100000}},"required":["x","y"],"additionalProperties":true}}},"required":["id","label","mode","nodeIds"],"additionalProperties":true},"affected":{"type":"object","properties":{"nodeId":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"},"level":{"enum":["direct","indirect","possible"]},"reason":{"type":"string","minLength":1,"maxLength":20000},"evidenceIds":{"type":"array","items":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"},"uniqueItems":true},"pathEdgeIds":{"type":"array","items":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"},"uniqueItems":true}},"required":["nodeId","level","reason","evidenceIds"],"additionalProperties":true},"test":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":20000},"status":{"enum":["passed","failed","not-run"]},"evidenceIds":{"type":"array","items":{"type":"string","patt